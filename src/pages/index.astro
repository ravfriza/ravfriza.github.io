---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site';
---

<Base>
  <section class="intro">
    <h1>Daffa Ravfriza</h1>
    <p class="muted subtitle">
      Hi, I'm Daffa, a fullstack developer at <a href="https://www.hotelmurah.com">HotelMurah.com</a>.
    </p>
    <p class="muted">
      I work on every HotelMurah.com product: hotel, flight, and train booking, plus digital top-ups
      like phone credit, electricity tokens, and e-wallets.
    </p>
    <p class="muted">
      I enjoy figuring out how things work and solving real problems quickly. The changes I'm proudest
      of made things easier for users and helped the business.
    </p>
    <p class="muted">
      Outside of work, mostly games. Resident Evil is my favorite series. <svg class="herb" viewBox="0 0 24 24" role="img" aria-label="Green herb"><title>Green herb</title><path fill="#2f8a3c" d="M12 15C8 14 5 11 4 7c4 1 7 4 8 8Zm0 0c4-1 7-4 8-8-4 1-7 4-8 8Z" /><path fill="#43b053" d="M12 15c-3-4-2-9 0-12 2 3 3 8 0 12Z" /><rect x="7" y="15" width="10" height="2" rx=".5" fill="#9a6a3a" /><path fill="#7a512b" d="M8 17h8l-1 5H9Z" /></svg>
    </p>
  </section>

  <section>
    <p class="muted">Find me on</p>
    <ul class="links">
      {
        site.links.map((link) => (
          <li>
            <a href={link.href}>
              <Icon name={link.icon} />
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  h1 {
    margin: 0 0 0.5rem;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  p {
    margin: 0 0 0.75rem;
  }

  .subtitle {
    margin-bottom: 1.5rem;
  }

  .herb {
    width: 1.15em;
    height: 1.15em;
    vertical-align: -0.2em;
    transition: transform 0.2s;
  }

  .herb:hover {
    transform: rotate(-10deg) scale(1.15);
  }

  .intro {
    margin-bottom: 3rem;
  }

  .links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.15rem;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--fg) 20%, transparent);
    transition: border-color 0.15s;
  }

  .links a:hover {
    border-color: var(--accent);
  }
</style>
