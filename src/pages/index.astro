---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site';
---

<Base>
  <section class="intro">
    <h1>Daffa Ravfriza</h1>
    <p class="muted">
      Hi, I'm Daffa, a web developer at <a href="https://www.hotelmurah.com">HotelMurah.com</a>. I
      work on the frontend of the hotel pages and the analytics tracking behind them.
    </p>
    <p class="muted">
      I got into computers by playing games on a Windows XP PC as a kid, and I've stayed curious about
      how things work ever since. That's also why I run <a href="https://fedoraproject.org">Fedora</a>.
    </p>
    <p class="muted">
      Outside of work, I'm usually playing games, reading, or watching movies.
    </p>
  </section>

  <section>
    <p class="muted">Find me on</p>
    <ul class="links">
      {
        site.links.map((link) => (
          <li>
            <a href={link.href}>
              <Icon name={link.icon} />
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  h1 {
    margin: 0 0 1rem;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  p {
    margin: 0 0 0.75rem;
  }

  .intro {
    margin-bottom: 3rem;
  }

  .links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.15rem;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--fg) 20%, transparent);
    transition: border-color 0.15s;
  }

  .links a:hover {
    border-color: var(--accent);
  }
</style>
