---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---

<Base>
  <section class="intro">
    <h1>Hi, I'm Daffa Ravfriza.</h1>
    <p class="muted">
      Web developer at <a href="https://www.hotelmurah.com">HotelMurah.com</a>. Outside of work,
      I'm usually watching movies, reading books, or playing games.
    </p>
    <p class="muted">This page is where I keep track of what I build. It grows as I do.</p>
  </section>

  <section class="row">
    <h2 class="label mono">elsewhere</h2>
    <ul class="links">
      {
        site.links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  h1 {
    margin: 0 0 1rem;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  p {
    margin: 0 0 0.75rem;
  }

  .intro {
    margin-left: var(--gutter);
    margin-bottom: 3.5rem;
  }

  .row {
    display: grid;
    grid-template-columns: var(--gutter) 1fr;
    margin-bottom: 2.75rem;
  }

  .label {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--muted);
    line-height: 1.65rem;
  }

  .links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
  }

  @media (max-width: 640px) {
    .intro {
      margin-left: 0;
    }

    .row {
      grid-template-columns: 1fr;
    }

    .label {
      margin-bottom: 0.5rem;
    }
  }
</style>
