---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site';
---

<Base>
  <section class="intro">
    <h1>Daffa Ravfriza</h1>
    <p class="muted subtitle">
      Hi, I'm Daffa, a fullstack developer at <a href="https://www.hotelmurah.com">HotelMurah.com</a>.
    </p>
    <p class="muted">
      I work across all of our products, from the pages people use to find and book hotels to the
      payment and order setup behind them.
    </p>
    <p class="muted">
      I like knowing how things work under the hood, a habit that started with a Windows XP PC and a
      lot of games as a kid.
    </p>
    <p class="muted">
      Outside of work, mostly games. Resident Evil is my favorite series.
    </p>
  </section>

  <section>
    <p class="muted">Find me on</p>
    <ul class="links">
      {
        site.links.map((link) => (
          <li>
            <a href={link.href}>
              <Icon name={link.icon} />
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  h1 {
    margin: 0 0 0.5rem;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  p {
    margin: 0 0 0.75rem;
  }

  .subtitle {
    margin-bottom: 1.5rem;
  }

  .intro {
    margin-bottom: 3rem;
  }

  .links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.15rem;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--fg) 20%, transparent);
    transition: border-color 0.15s;
  }

  .links a:hover {
    border-color: var(--accent);
  }
</style>
