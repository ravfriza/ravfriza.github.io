---
import Base from '../layouts/Base.astro';
import Coin from '../components/Coin.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site';
---

<Base>
  <section class="intro">
    <h1>Daffa Ravfriza</h1>
    <p class="muted subtitle">
      Hi, I'm Daffa, a fullstack developer at <a href="https://www.hotelmurah.com">HotelMurah.com</a>.
    </p>
    <p class="muted">
      I work on every HotelMurah.com product: hotel, flight, and train booking, plus digital top-ups
      like phone credit, electricity tokens, and e-wallets.
    </p>
    <p class="muted">
      I enjoy figuring out how things work and solving real problems quickly. The changes I'm proudest
      of made things easier for users and helped the business.
    </p>
    <p class="muted">
      Outside of work, mostly games. Resident Evil is my favorite series. 🧟
    </p>
  </section>

  <section>
    <p class="muted">Find me on</p>
    <ul class="links">
      {
        site.links.map((link) => (
          <li>
            <a href={link.href}>
              <Icon name={link.icon} />
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="muted mail">
      Or mail me at <a href={`mailto:${site.email}`} class="mono" id="email" title="Click to copy">{site.email}</a> <span id="copied" class="copied mono" aria-live="polite"></span>
    </p>
  </section>

  <section class="coin-section">
    <Coin />
  </section>
</Base>

<script>
  // Runs on every visit to this page, including client-side navigations back to it.
  document.addEventListener('astro:page-load', () => {
    const email = document.getElementById('email');
    const copied = document.getElementById('copied');
    if (!email || !copied) return;
    let timer = 0;
    email.addEventListener('click', async (event) => {
      if (!navigator.clipboard) return; // fall back to the mailto link
      event.preventDefault();
      try {
        await navigator.clipboard.writeText(email.textContent ?? '');
      } catch {
        location.href = email.getAttribute('href') ?? '';
        return;
      }
      copied.textContent = 'Copied';
      copied.classList.add('show');
      clearTimeout(timer);
      timer = window.setTimeout(() => copied.classList.remove('show'), 1500);
    });
  });
</script>

<style>
  h1 {
    margin: 0 0 0.5rem;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  p {
    margin: 0 0 0.75rem;
  }

  .subtitle {
    margin-bottom: 1.5rem;
  }

  .intro {
    margin-bottom: 3rem;
  }

  .links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.15rem;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--fg) 20%, transparent);
    transition: border-color 0.15s;
  }

  .links a:hover {
    border-color: var(--fg);
  }

  .coin-section {
    margin-top: 3rem;
  }

  .mail {
    margin-top: 1.5rem;
  }

  .copied {
    font-size: 0.75rem;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .copied.show {
    opacity: 1;
  }
</style>
