---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site';
---

<Base>
  <section class="intro">
    <h1>Daffa Ravfriza</h1>
    <p class="muted subtitle">
      Hi, I'm Daffa, a fullstack developer at <a href="https://www.hotelmurah.com">HotelMurah.com</a>.
    </p>
    <p class="muted">
      I work on every HotelMurah.com product: hotel, flight, and train booking, plus digital top-ups
      like phone credit, electricity tokens, and e-wallets.
    </p>
    <p class="muted">
      I enjoy figuring out how things work and solving real problems quickly. The changes I'm proudest
      of made things easier for users and helped the business.
    </p>
    <p class="muted">
      Outside of work, mostly games. Resident Evil is my favorite series. 🧟
    </p>
  </section>

  <section class="projects">
    <h2>Projects</h2>
    <p class="muted"><span class="wip mono">WIP</span> Work in progress. Projects will show up here once they ship.</p>
  </section>

  <section class="notes">
    <h2>Notes</h2>
    <p class="muted"><span class="wip mono">WIP</span> Work in progress. Notes will show up here once I write them.</p>
  </section>

  <section>
    <p class="muted">Find me on</p>
    <ul class="links">
      {
        site.links.map((link) => (
          <li>
            <a href={link.href}>
              <Icon name={link.icon} />
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="muted mail">
      Or mail me at <a href={`mailto:${site.email}`} class="mono">{site.email}</a>
    </p>
  </section>
</Base>

<style>
  h1 {
    margin: 0 0 0.5rem;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  p {
    margin: 0 0 0.75rem;
  }

  .subtitle {
    margin-bottom: 1.5rem;
  }

  .intro,
  .projects,
  .notes {
    margin-bottom: 3rem;
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .wip {
    margin-right: 0.4rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: 0.75rem;
    vertical-align: 0.1em;
  }

  .links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.15rem;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--fg) 20%, transparent);
    transition: border-color 0.15s;
  }

  .links a:hover {
    border-color: var(--fg);
  }

  .mail {
    margin-top: 1.5rem;
  }
</style>
