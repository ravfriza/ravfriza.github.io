---
import { Font } from 'astro:assets';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-schibsted" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, fullstack developer at HotelMurah.com`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    </script>
  </head>
  <body>
    <div class="page">
      <header>
        <a href="/" class="mono handle" aria-label={site.handle}>{site.handle}</a>
        <nav class="nav">
          <s class="mono soon" tabindex="0" data-tip="still in progress" aria-label="projects, still in progress">projects</s>
          <s class="mono soon" tabindex="0" data-tip="still in progress" aria-label="notes, still in progress">notes</s>
          <a href="/uses" class="mono">uses</a>
          <button type="button" id="theme-toggle" class="mono" aria-label="Toggle dark mode">◐</button>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        © {new Date().getFullYear()} {site.name}
      </footer>
    </div>
    <script>
      const root = document.documentElement;
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Theme toggle: the new theme grows out of the button as a circle.
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        const apply = () => {
          root.dataset.theme = next;
          localStorage.setItem('theme', next);
        };
        if (!('startViewTransition' in document) || reduceMotion) return apply();

        const { left, top, width, height } = toggle.getBoundingClientRect();
        const x = left + width / 2;
        const y = top + height / 2;
        const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        document.startViewTransition(apply).ready.then(() => {
          root.animate(
            { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
            { duration: 500, easing: 'ease-in-out', pseudoElement: '::view-transition-new(root)' },
          );
        });
      });

      // Handle: characters scramble, then settle left to right.
      const handle = document.querySelector<HTMLElement>('.handle');
      if (handle && !reduceMotion) {
        const text = handle.textContent ?? '';
        const glyphs = 'abcdefghijklmnopqrstuvwxyz0123456789#%&*+=<>/';
        let raf = 0;
        const scramble = () => {
          cancelAnimationFrame(raf);
          let frame = 0;
          const step = () => {
            const settled = frame / 3;
            handle.textContent = [...text]
              .map((char, i) => (i < settled ? char : glyphs[(Math.random() * glyphs.length) | 0]))
              .join('');
            if (settled < text.length) {
              frame++;
              raf = requestAnimationFrame(step);
            }
          };
          step();
        };
        handle.addEventListener('mouseenter', scramble);
        handle.addEventListener('focus', scramble);
      }

      // Grid lines brighten near the pointer (mouse/trackpad only).
      if (matchMedia('(pointer: fine)').matches) {
        let raf = 0;
        addEventListener('pointermove', (event) => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            root.style.setProperty('--mx', `${event.clientX}px`);
            root.style.setProperty('--my', `${event.clientY}px`);
          });
        });
        document.addEventListener('pointerleave', () => {
          root.style.removeProperty('--mx');
          root.style.removeProperty('--my');
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfbfa;
    --fg: #1c1c1b;
    --muted: #6e6e69;
    --border: #e4e4e0;
    --sans: var(--font-schibsted);
    --mono: var(--font-jetbrains-mono);
    --line: color-mix(in srgb, var(--fg) 10%, transparent);
    --line-lit: color-mix(in srgb, var(--fg) 85%, transparent);
    --mx: -100vmax;
    --my: -100vmax;
    /* Fixed attachment positions the spotlight in viewport coordinates on every line. */
    --line-bg: radial-gradient(circle 200px at var(--mx) var(--my), var(--line-lit), var(--line))
      fixed;
    color-scheme: light;
  }

  :root[data-theme='dark'] {
    --bg: #050505;
    --fg: #fff;
    --muted: #a3a3a3;
    --border: #1c1c1c;
    color-scheme: dark;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }

  body {
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--fg) 30%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }

  a:hover {
    text-decoration-color: var(--fg);
  }

  .mono {
    font-family: var(--mono);
  }

  .muted {
    color: var(--muted);
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
</style>

<style>
  .page {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    max-width: 51rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 3rem;
  }

  main {
    flex: 1;
  }

  header,
  footer {
    position: relative;
  }

  /* Side lines of the column, plus full-bleed rules under the header and above the footer. */
  .page::before,
  .page::after,
  header::after,
  footer::before {
    content: '';
    position: absolute;
    background: var(--line-bg);
  }

  .page::before,
  .page::after {
    top: 0;
    bottom: 0;
    width: 1px;
  }

  .page::before {
    left: 0;
  }

  .page::after {
    right: 0;
  }

  header::after,
  footer::before {
    left: calc(50% - 50vw);
    width: 100vw;
    height: 1px;
  }

  header::after {
    bottom: 0;
  }

  footer::before {
    top: 0;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 2.5rem;
    margin-bottom: 3.5rem;
    font-size: 0.875rem;
  }

  .handle {
    text-decoration: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--fg);
  }

  .soon {
    position: relative;
    color: color-mix(in srgb, var(--muted) 60%, transparent);
    cursor: default;
    outline: none;
  }

  .soon::after {
    content: attr(data-tip);
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 2;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg);
    color: var(--muted);
    font-size: 0.75rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-2px);
    transition:
      opacity 0.15s,
      transform 0.15s;
  }

  .soon:hover::after,
  .soon:focus::after {
    opacity: 1;
    transform: none;
  }

  #theme-toggle {
    background: none;
    border: 0;
    padding: 0.25rem;
    color: var(--muted);
    font-size: 1rem;
    cursor: pointer;
  }

  #theme-toggle:hover {
    color: var(--fg);
  }

  footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  @media (max-width: 640px) {
    .page {
      padding-top: 1rem;
    }

    .page::before,
    .page::after {
      display: none;
    }

    header {
      padding-bottom: 1rem;
      margin-bottom: 1.75rem;
    }

    .nav {
      gap: 0.75rem;
    }
  }
</style>
