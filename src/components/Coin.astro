---
// Line drawing of the Rp1.000 coin (2016 issue) in the site's monochrome style.
// The number side follows the real layout; the picture side uses a generic bust in place of the
// portrait and leaves out the Garuda Pancasila emblem, whose use is restricted by law.
const ring = Array.from({ length: 56 }, (_, i) => {
  const a = (i / 56) * Math.PI * 2;
  return { x: 100 + 84 * Math.cos(a), y: 100 + 84 * Math.sin(a) };
});
---

<div class="coin-flip">
  <button type="button" class="coin-button" aria-label="Flip a coin">
    <span class="toss">
      <span class="coin">
        <span class="face heads" aria-hidden="true">
          <svg viewBox="0 0 200 200">
            <defs>
              <path id="coin-arc" d="M 32 100 A 68 68 0 0 1 168 100" />
            </defs>
            <circle cx="100" cy="100" r="98" class="edge" />
            <circle cx="100" cy="100" r="91" class="rim" />
            <text class="label"><textPath href="#coin-arc" startOffset="50%" text-anchor="middle">REPUBLIK INDONESIA</textPath></text>
            <path
              class="bust"
              d="M100 62c-14 0-24 11-24 26 0 10 4 18 10 23v9c-15 4-27 12-31 24 12 14 28 20 45 20s33-6 45-20c-4-12-16-20-31-24v-9c6-5 10-13 10-23 0-15-10-26-24-26Z"
            />
          </svg>
        </span>

        <span class="face tails" aria-hidden="true">
          <svg viewBox="0 0 200 200">
            <circle cx="100" cy="100" r="98" class="edge" />
            <circle cx="100" cy="100" r="91" class="rim" />
            {ring.map((p) => <circle cx={p.x.toFixed(2)} cy={p.y.toFixed(2)} r="2.2" class="dot" />)}
            <text class="label"><textPath href="#coin-arc" startOffset="50%" text-anchor="middle">BANK INDONESIA</textPath></text>
            <text class="value" x="100" y="117" text-anchor="middle">1000</text>
            <text class="label" x="100" y="139" text-anchor="middle">RUPIAH</text>
            <text class="label" x="100" y="163" text-anchor="middle">2016</text>
          </svg>
        </span>
      </span>
    </span>
  </button>
  <span class="result mono" aria-live="polite">flip me</span>
</div>

<script>
  // Rare easter egg: sometimes the landing comes with a meme sound.
  const SOUND_CHANCE = 1 / 8;
  const SOUNDS = ['fah', 'vine-boom', 'undertaker-bell', 'fart'].map((name) => `/sounds/${name}.mp3`);

  // Runs on every visit to a page with the coin, including client-side navigations back to it.
  document.addEventListener('astro:page-load', () => {
    const button = document.querySelector<HTMLButtonElement>('.coin-button');
    const coin = button?.querySelector<HTMLElement>('.coin');
    const result = document.querySelector<HTMLElement>('.coin-flip .result');
    if (!button || !coin || !result) return;

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const duration = reduceMotion ? 0 : 1100;
    let angle = 180; // starts on the 1000 side (tails)
    let flipping = false;
    let last = '';
    let streak = 0;

    button.addEventListener('click', () => {
      if (flipping) return;
      flipping = true;

      const heads = Math.random() < 0.5;
      // Pick and start loading the sound inside the click, so browsers treat playback as user-initiated.
      const sound =
        Math.random() < SOUND_CHANCE
          ? new Audio(SOUNDS[Math.floor(Math.random() * SOUNDS.length)])
          : null;
      // Land on a multiple of 360° for heads, offset by 180° for tails, after a few full turns.
      let target = angle - (angle % 360) + (reduceMotion ? 0 : 5 * 360) + (heads ? 0 : 180);
      if (target <= angle) target += 360;
      angle = target;

      button.classList.remove('tossing');
      void button.offsetWidth; // restart the toss animation
      button.classList.add('tossing');
      coin.style.transform = `rotateX(${angle}deg)`;

      setTimeout(() => {
        const outcome = heads ? 'heads' : 'tails';
        streak = outcome === last ? streak + 1 : 1;
        last = outcome;
        result.textContent = streak > 1 ? `${outcome} ×${streak}` : outcome;
        flipping = false;
        if (sound) {
          sound.volume = 0.6;
          sound.play().catch(() => {}); // autoplay blocked or offline: stay silent
        }
      }, duration);
    });
  });
</script>

<style>
  .coin-flip {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .coin-button {
    width: 5.5rem;
    height: 5.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg);
    cursor: pointer;
  }

  .toss {
    display: block;
    width: 100%;
    height: 100%;
    perspective: 700px;
  }

  .tossing .toss {
    animation: toss 1100ms;
  }

  @keyframes toss {
    0% {
      transform: translateY(0);
      animation-timing-function: cubic-bezier(0.2, 0.7, 0.4, 1);
    }
    50% {
      transform: translateY(-5rem);
      animation-timing-function: cubic-bezier(0.6, 0, 0.8, 0.3);
    }
    100% {
      transform: translateY(0);
    }
  }

  .coin {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(180deg);
    transition: transform 1100ms cubic-bezier(0.2, 0.6, 0.3, 1);
  }

  .face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
  }

  .tails {
    transform: rotateX(180deg);
  }

  .face svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .edge {
    fill: var(--bg);
    stroke: currentColor;
    stroke-width: 2.5;
  }

  .rim,
  .dot,
  .bust {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.2;
  }

  .label {
    fill: var(--muted);
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 2px;
  }

  .value {
    fill: currentColor;
    font-family: var(--sans);
    font-size: 46px;
    font-weight: 600;
    letter-spacing: -1px;
  }

  .result {
    font-size: 0.75rem;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .tossing .toss {
      animation: none;
    }

    .coin {
      transition: none;
    }
  }
</style>
