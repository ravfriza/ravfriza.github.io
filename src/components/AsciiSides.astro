---
// Decorative ASCII art in the empty side margins on wide screens.
// Left: the old PC where it all started. Right: games.
const pc = String.raw`
 .-------------------------.
 | .---------------------. |
 | |                     | |
 | |  C:\> hello, world  | |
 | |  C:\> _             | |
 | |                     | |
 | |                     | |
 | '---------------------' |
 |   ________     o  ===   |
 '-------------------------'
          |       |
       ___|_______|___
      '---------------'
  .---------------------------.
 / [=][=][=][=][=][=][=][=][=] \
/ [==][=][=][=][=][=][=][====] \
'-------------------------------'
`;

const controller = String.raw`
     _____________________________
    /  [L1]                 [R1]  \
   /                               \
  |     _                   (Y)     |
  |   _| |_             (X)     (B) |
  |  |_   _|  [sel] [st]    (A)     |
  |    |_|                          |
  |        .---.       .---.        |
   \       | o |       | o |       /
    \      '---'  ___  '---'      /
     \___________/   \___________/
`;
---

<div class="ascii-sides" aria-hidden="true">
  <pre class="ascii left">{pc}</pre>
  <pre class="ascii right">{controller}</pre>
</div>

<style>
  .ascii-sides {
    display: none;
  }

  /* Only when each side margin is wide enough to hold the art. */
  @media (min-width: 1300px) {
    .ascii-sides {
      display: block;
    }
  }

  .ascii {
    position: fixed;
    top: 50%;
    margin: 0;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.25;
    /* Same spotlight as the frame lines (fixed attachment), slightly brighter base so thin glyphs read. */
    background: radial-gradient(
        circle 200px at var(--mx) var(--my),
        var(--line-lit),
        color-mix(in srgb, var(--fg) 18%, transparent)
      )
      fixed;
    transform: translateY(-50%);
    /* Same gradient as the frame lines, so the art lights up under the pointer spotlight. */
    background: var(--line-bg);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  /* Center each piece in its margin: margin width is (100vw - 51rem) / 2. */
  .left {
    left: calc((100vw - 51rem) / 4);
    translate: -50% 0;
  }

  .right {
    right: calc((100vw - 51rem) / 4);
    translate: 50% 0;
  }
</style>
